<link rel="stylesheet" href="/css/partials/header.module.css">
<div class="navbar">
  <div class="logo-item d-flex common-item">
    <img src="img/logo.png" alt="Logo page">
    <p>EoAb</p>
  </div>

  <div class="list-item d-flex justify-content-betweeen align-item-center common-item">
    <div class="item">
      <div class="content-item">
        <a href="" class="text-decoration-none">Home</a> 
      </div>
    </div>
    
    <div class="item">
      <div class="content-item">
        <a href="" class="text-decoration-none dropdown-toggle">Course <i class="fas fa-caret-down"></i></a> 
      </div>
      <div class="dropdown-menu">
        <a href="/courses/web-development" class="text-decoration-none dropdown-item">Phát triển Web</a>
        <a href="/courses/data-science" class="text-decoration-none dropdown-item">Khoa học Dữ liệu</a>
        <a href="/courses/mobile-development" class="text-decoration-none dropdown-item">Phát triển Mobile</a>
        <a href="/courses/devops" class="text-decoration-none dropdown-item">DevOps</a>
        <a href="/courses/all" class="text-decoration-none dropdown-item">Tất cả Khóa học</a>
      </div>
    </div>

    <div class="item">
      <div class="content-item">
        <a href="" class="text-decoration-none">Blog</a> 
      </div>
    </div>

    <div class="item">
      <div class="content-item">
        <a href="" class="text-decoration-none">Community</a> 
      </div>
    </div>

    <div class="item">
      <div class="content-item">
        <a href="" class="text-decoration-none">About Us</a> 
      </div>
    </div>

    <div class="item">
      <div class="content-item">
        <a href="" class="text-decoration-none">Contact</a> 
      </div>
    </div>
  </div>

  <div class="user-item d-flex common-item">
      {{#unless userInfor}}
        <button><a href="/auth/login" class="text-decoration-none">Sign in</a></button>
        <button><a href="/auth/register" class="text-decoration-none">Sign up</a></button>
        {{else}}
          <img src="{{userInfor.image}}" alt="img of user">
          <button>{{userInfor.lastName}} {{userInfor.firstName}}</button>
      {{/unless}}
  </div>
</div>