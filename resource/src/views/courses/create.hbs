<div class="mt-4">
    <h1>Create Course</h1>

    <form action="/courses/{{course._id}}?_method=PUT" method="POST">

        <div class="form-group mt-4">
            <label for="name">Name</label>
            <input type="text" name="name" class="form-control" id="name" placeholder="Course Name">
        </div>

        <div class="form-group mt-4">
            <label for="description">Description</label>
            <input type="text" name="description" class="form-control" id="description" placeholder="Course Description">
        </div>

        <div class="form-group mt-4">
            <label for="videoID">Video ID</label>
            <input type="text" name="videoID" class="form-control" id="videoID" placeholder="Course VideoID">
        </div>

        <div class="form-group mt-4">
            <label for="educationLevel">Education Level</label>
            <input type="text" name="educationLevel" class="form-control" id="educationLevel" placeholder="Course EducationLevel">
        </div>

        <div class="form-group mt-4">
            <label for="slug">Course Slug</label>
            <input type="text" name="slug" class="form-control" id="slug" placeholder="Course slug">
        </div>

        <button type="submit" class="btn btn-primary mt-4">Add course</button>
    </form>
</div>