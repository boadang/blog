<div class="mt-4">
    <h1>Add Lesson to Course</h1>

    <form action="/courses/{{course.slug}}/lessons" method="POST">

        <div class="form-group mt-4">
            <label for="title">Title</label>
            <input type="text" name="title" class="form-control" id="title" placeholder="Lesson Title" required>
        </div>

        <div class="form-group mt-4">
            <label for="description">Description</label>
            <input type="text" name="description" class="form-control" id="description" placeholder="Lesson Description">
        </div>

        <div class="form-group mt-4">
            <label for="videoId">Video URL</label>
            <input type="text" name="videoId" class="form-control" id="videoId" placeholder="Lesson Video URL" required>
        </div>

        <div class="form-group mt-4">
            <label for="duration">Duration (in seconds)</label>
            <input type="number" name="duration" class="form-control" id="duration" placeholder="Lesson duration in seconds" min="1" required>
        </div>

        <button type="submit" class="btn btn-primary mt-4">Add Lesson</button>
    </form>
</div>