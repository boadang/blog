    "description": "",
    "lint-staged": {
        "**/*.{js,json,css,scss,html}": [
            "prettier --single-quote --trailing-comma all --tab-width 4 --write"
        ]
    },

    "husky": {
      "hooks": {
        "pre-commit": "lint-staged"
      }
    },

    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.1.2",
        "nodemon": "^3.1.10",
